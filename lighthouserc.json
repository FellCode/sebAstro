{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --host --port 4321",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4321/sebAstro/",
        "http://localhost:4321/sebAstro/verein/",
        "http://localhost:4321/sebAstro/vorstand/",
        "http://localhost:4321/sebAstro/socials/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2800 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}

