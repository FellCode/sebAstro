---
import Layout from "../layouts/Layout.astro";
import Gallery from "../components/Gallery.astro";
import ScrollIndicator from "../components/ScrollIndicator.astro";
import HeroBanner from "../components/HeroBanner.astro";
import heroImage from "../assets/images/hero.webp";
---

<Layout
  title="Schützenfest 2025 | Galerie"
  description="Die schönsten Momente vom Schützenfest 2025 der St. Sebastianus Schützenbruderschaft Horrem."
>
  <section
    class="relative flex min-h-screen flex-col items-center justify-center text-center text-white"
  >
    <HeroBanner image={heroImage} alt="Hero-Bild Schützenfest" />
    <div class="mt-24">
      <h3 class="text-[28px] font-normal font-['Open_Sans'] mb-5 text-white">
        Hier findest du unsere schönsten Momente vom
      </h3>
      <h1
        class="text-[36px] sm:text-[60px] font-bold font-['Open_Sans'] mb-4 text-white"
      >
        Schützenfest 2025
      </h1>
    </div>
    <ScrollIndicator />
  </section>
  <section
    class="bg-[#83cea5] px-6 sm:px-10 lg:px-20 py-40 items-center justify-center text"
  >
    <div>
      <Gallery folder="assets/img/schuetzenfest_2025" />
    </div>
  </section>
</Layout>
