---
import Layout from "../layouts/Layout.astro";
import ScrollIndicator from "../components/ScrollIndicator.astro";
import Gallery from "../components/Gallery.astro";
import HeroBanner from "../components/HeroBanner.astro";
import heroImage from "../assets/images/hero.webp";
---

<Layout
  title="Vermietung Vereinsheim | St. Sebastianus Schützenbruderschaft Horrem"
  description="Informationen zur Vermietung des Vereinsheims inklusive Ansprechpartner und Rahmenbedingungen."
>
  <section
    class="relative flex min-h-screen flex-col items-center justify-center text-center text-white"
  >
    <HeroBanner image={heroImage} alt="Hero-Bild Vermietung" />
    <div class="mt-24">
      <h3 class="page-subtitle text-white">
        Informationen zur
      </h3>
      <h1 class="page-title text-white">
        Vermietung unseres Vereinsheims
      </h1>
    </div>
    <ScrollIndicator />
  </section>

  <section class="section-shell section-light flex flex-col items-center md:flex-row">
    <div class="w-full md:w-1/2 flex justify-center mb-8 md:mb-0">
      <img
        src={`${import.meta.env.BASE_URL}assets/img/vorstand.webp`}
        alt="Bild Schützenheim"
        class="rounded-md shadow-lg max-h-[400px] object-cover"
      />
    </div>

    <div class="w-full md:w-1/2 text-center md:text-left">
      <h3 class="section-title">
        Eckdaten
      </h3>

      <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div class="rounded-md bg-white/60 p-4">
          <p class="text-sm font-semibold uppercase tracking-wide text-[#4f7c5f]">Kapazität Saal</p>
          <p class="body-copy !m-0">Bis zu 120 Personen</p>
        </div>
        <div class="rounded-md bg-white/60 p-4">
          <p class="text-sm font-semibold uppercase tracking-wide text-[#4f7c5f]">Kapazität Thekenbereich</p>
          <p class="body-copy !m-0">Bis zu 30 Personen</p>
        </div>
        <div class="rounded-md bg-white/60 p-4">
          <p class="text-sm font-semibold uppercase tracking-wide text-[#4f7c5f]">Ausstattung</p>
          <p class="body-copy !m-0">Küchenbereich, Toiletten, Kühlhaus (bitte bei Anfrage bestätigen)</p>
        </div>
        <div class="rounded-md bg-white/60 p-4">
          <p class="text-sm font-semibold uppercase tracking-wide text-[#4f7c5f]">Mobiliar</p>
          <p class="body-copy !m-0">Tische und Polsterstühle für ca. 120 Personen</p>
        </div>
        <div class="rounded-md bg-white/60 p-4 sm:col-span-2">
          <p class="text-sm font-semibold uppercase tracking-wide text-[#4f7c5f]">Außenbereich</p>
          <p class="body-copy !m-0">Überdachter Außenbereich und Wiesenfläche nach Absprache nutzbar</p>
        </div>
      </div>
    </div>
  </section>
  <section class="section-shell section-mint items-center justify-center py-40 text">
    <Gallery folder="assets/img/vermietung" />
  </section>
  <section class="section-shell section-light flex flex-col items-center text-center">
    <h3 class="section-title">
        Hinweise zur Vermietung
     </h3>
    <p class="body-copy">
      Ob Familienfeier, Geburtstag, Vereinsabend oder Firmenevent: Unser Vereinsheim bietet den
      passenden Rahmen für Veranstaltungen in angenehmer Atmosphäre. Ihr könnt den großen Saal
      (bis zu 120 Personen) und den Schankraum (bis zu 30 Personen) gemeinsam oder separat mieten.
      Vor Ort stehen Euch ein Küchenbereich, ein Kühlhaus, Toiletten sowie Mobiliar für rund
      120 Gäste (Tische und Polsterstühle) zur Verfügung. Der überdachte Außenbereich und die
      Wiesenfläche können nach vorheriger Absprache ebenfalls genutzt werden.<br /><br />

      Bei Nutzung des Schankraums ist eine Servicekraft für den Thekenbetrieb verpflichtend.
      Bei Nutzung der Küche ist eine weitere Servicekraft verpflichtend.<br /><br />
    </p>
  </section>

 <section class="section-shell section-mint flex flex-col items-center text-center">
  <h3 class="section-title">
        Du willst unser Heim mieten?
     </h3>
    <p class="body-copy">
        Dann schreib uns einfach eine Mail an:       <a href="mailto:kontakt@seb-horrem.de" class="underline text-green-800"
        >kontakt@seb-horrem.de</a
      >
    </p>
</section>

</Layout>
