---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Chronik Majestäten | St. Sebastianus Schützenbruderschaft Horrem"
  description="Historische Übersicht der Majestäten der St. Sebastianus Schützenbruderschaft Horrem."
>
  <section class="section-shell section-light text-center">
    <h1 class="mb-8 text-[36px] font-bold">Chronik: Majestäten</h1>
    <p class="max-w-[900px] mx-auto leading-8">
      Diese Seite wird als Übersicht für die historischen Majestäten der
      Bruderschaft aufgebaut. Die Chronik wird sukzessive erweitert und mit
      weiteren Jahrgängen ergänzt.
    </p>
  </section>
</Layout>
