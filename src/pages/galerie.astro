---
import Layout from "../layouts/Layout.astro";
import Gallery from "../components/Gallery.astro";
import ScrollIndicator from "../components/ScrollIndicator.astro";
import HeroBanner from "../components/HeroBanner.astro";
import heroImage from "../assets/images/hero.webp";
---

<Layout
  title="Galerie | St. Sebastianus Schützenbruderschaft Horrem"
  description="Fotogalerie der St. Sebastianus Schützenbruderschaft Horrem mit Eindrücken aus dem Vereinsleben."
>
  <section
    class="relative flex min-h-screen flex-col items-center justify-center text-center text-white"
  >
    <HeroBanner image={heroImage} alt="Hero-Bild der Galerie" />
    <div class="mt-24">
      <h1 class="page-title text-white">Galerie</h1>
    </div>
    <ScrollIndicator />
  </section>
  <section class="section-shell section-mint items-center justify-center px-8">
    <div>
      <Gallery folder="assets/img/schuetzenfest_2025" />
    </div>
  </section>
</Layout>
