---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import ScrollIndicator from "../components/ScrollIndicator.astro";
import HeroBanner from "../components/HeroBanner.astro";
import heroImage from "../assets/images/hero.webp";
import vorstandCardImage from "../assets/images/placeholder-people.svg";
---

<Layout
  title="Vorstand | St. Sebastianus Schützenbruderschaft Horrem"
  description="Der geschäftsführende und erweiterte Vorstand der St. Sebastianus Schützenbruderschaft Horrem im Überblick."
>
  <section
    class="relative flex min-h-screen flex-col items-center justify-center text-center text-white"
  >
    <HeroBanner image={heroImage} alt="Vorstand der Schützenbruderschaft" />
    <div class="mt-24">
      <h1 class="page-title text-white">
        Unser Geschäftsführender Vorstand
      </h1>
    </div>
    <ScrollIndicator />
  </section>

  <section class="section-shell section-light flex flex-col items-center text-center">
    <Image
      src={vorstandCardImage}
      class="max-w-[600px] mb-2 border-2 rounded-sm mx-auto w-full"
      alt="Gruppenfoto des geschäftsführenden Vorstands"
      widths={[600, 900, 1200]}
      sizes="(min-width: 1024px) 600px, 100vw"
      loading="lazy"
      decoding="async"
    />
    <p class="text-text-muted">
      Unser Geschäftsführender Vorstand von Links nach Rechts:<br />
      <strong> Brudermeister</strong><em> Christian Kurm</em><br />
      <strong>Stellv. Brudermeisterin</strong><em> Angelika Dahmen</em><br />
      <strong>Geschäftsführer</strong><em> Hans-Wilhelm Dahmen</em><br />
      <strong>Schatzmeister</strong><em> Heinz-Erhardt-Clermont</em>
    </p>
  </section>

  <section class="section-shell section-mint items-center justify-center">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Card 1 -->
        <div class="card bg-base-100 text-white shadow-xl">
          <figure>
            <Image
              src={vorstandCardImage}
              alt="Porträt Brudermeister Christian Kurm"
              class="object-cover h-96 w-full"
              widths={[480, 768, 1200]}
              sizes="(min-width: 768px) 50vw, 100vw"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="card-body items-center text-center">
            <h3 class="card-title">Brudermeister</h3>
            <p class="text-lg">Christian Kurm</p>
            <a href="mailto:kontakt@seb-horrem.de" class="underline text-green-400">
              kontakt@seb-horrem.de
            </a>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="card bg-base-100 text-white shadow-xl">
          <figure>
            <Image
              src={vorstandCardImage}
              alt="Porträt stellvertretende Brudermeisterin Angelika Dahmen"
              class="object-cover h-96 w-full"
              widths={[480, 768, 1200]}
              sizes="(min-width: 768px) 50vw, 100vw"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="card-body items-center text-center">
            <h3 class="card-title">Stellv. Brudermeisterin</h3>
            <p class="text-lg">Angelika Dahmen</p>
            <a href="mailto:kontakt@seb-horrem.de" class="underline text-green-400">
              kontakt@seb-horrem.de
            </a>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="card bg-base-100 text-white shadow-xl">
          <figure>
            <Image
              src={vorstandCardImage}
              alt="Porträt Geschäftsführer Hans-Wilhelm Dahmen"
              class="object-cover h-96 w-full"
              widths={[480, 768, 1200]}
              sizes="(min-width: 768px) 50vw, 100vw"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="card-body items-center text-center">
            <h3 class="card-title">Geschäftsführer</h3>
            <p class="text-lg">Hans-Wilhelm Dahmen</p>
            <a href="mailto:kontakt@seb-horrem.de" class="underline text-green-400">
              kontakt@seb-horrem.de
            </a>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="card bg-base-100 text-white shadow-xl">
          <figure>
            <Image
              src={vorstandCardImage}
              alt="Porträt Schatzmeister Heinz-Erhardt Clermont"
              class="object-cover h-96 w-full"
              widths={[480, 768, 1200]}
              sizes="(min-width: 768px) 50vw, 100vw"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="card-body items-center text-center">
            <h3 class="card-title">Schatzmeister</h3>
            <p class="text-lg">Heinz-Erhardt Clermont</p>
            <a
              href="mailto:schatzmeister@seb-horrem.de"
              class="underline text-green-400"
            >
              schatzmeister@seb-horrem.de
            </a>
          </div>
        </div>

        <!-- Card über beide Spalten -->
        <div
          class="card bg-base-100 text-white shadow-xl md:col-span-2"
        >
          <figure>
            <Image
              src={vorstandCardImage}
              alt="Gruppenfoto erweiterter Vorstand"
              class="object-cover h-96 w-full"
              widths={[768, 1200, 1600]}
              sizes="100vw"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="card-body items-center text-left">
            <h3 class="card-title">Erweiterter Vorstand</h3>

            <div class="mt-4 space-y-4">
              <div class="grid grid-cols-2 gap-x-40">
                <span class="font-semibold">Stellv. Schatzmeisterin:</span>
                <span class="text-right">Magdalena Baumeister</span>
              </div>
              <div class="grid grid-cols-2 gap-x-40">
                <span class="font-semibold">Stellv. Geschäftsführer:</span>
                <span class="text-right">Felix Vogel</span>
              </div>
              <div class="grid grid-cols-2 gap-x-40">
                <span class="font-semibold">Schießmeisterin:</span>
                <span class="text-right">Anne Vogel</span>
              </div>
              <div class="grid grid-cols-2 gap-x-40">
                <span class="font-semibold">Stellv. Schießmeister RSB:</span>
                <span class="text-right">Heinrich Bock</span>
              </div>
              <div class="grid grid-cols-2 gap-x-40">
                <span class="font-semibold">Jungschützenmeisterin:</span>
                <span class="text-right">Anne Vogel</span>
              </div>
              <div class="grid grid-cols-2 gap-x-40">
                <span class="font-semibold">Stellv. Jungschützenmeister:</span>
                <span class="text-right">Felix Vogel</span>
              </div>
              <div class="grid grid-cols-2 gap-x-40">
                <span class="font-semibold">Fähnrich Jugend:</span>
                <span class="text-right">Jonas Schuchmann</span>
              </div>
            </div>
            <p class="mt-4">
              <em
                >Ebenfalls teil des Erweiterten Vorstands sind die amtierenden
                Majestäten</em
              >
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
