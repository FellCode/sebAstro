---
import Layout from "../layouts/Layout.astro";
import ScrollIndicator from "../components/ScrollIndicator.astro";
import HeroBanner from "../components/HeroBanner.astro";
import heroImage from "../assets/images/hero.webp";
---

<Layout
  title="St. Sebastianus Schützenbruderschaft Horrem seit 1550 e.V."
  description="Offizielle Vereinsseite der St. Sebastianus Schützenbruderschaft Horrem mit Veranstaltungen, Ansprechpartnern, Schießsport und Vermietungsinformationen."
>
  <section
    class="relative flex min-h-screen flex-col items-center justify-center text-center text-white"
  >
    <HeroBanner image={heroImage} alt="Historisches Banner der Bruderschaft" priority />
    <div class="mt-24">
      <h3 class="page-subtitle text-white">
        Willkommen bei der
      </h3>
      <h1 class="page-title text-white">
        St. Sebastianus Schützenbruderschaft Horrem<br />
        seit 1550 e.V.
      </h1>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a class="btn btn-soft btn-success" href={`${import.meta.env.BASE_URL}where/`}>Hier findest du uns</a>
        <a class="btn btn-soft btn-success" href={`${import.meta.env.BASE_URL}socials/`}>Socials</a>
      </div>
    </div>
    <ScrollIndicator />
  </section>

  <section class="section-shell section-mint flex flex-col items-center text-justify sm:text-center">
    <h2 class="section-title">
      Herzlich Willkommen bei den St. Sebastianus Schützen
    </h2>
    <p class="body-copy">
      Wir freuen uns, dass du den Weg zu uns gefunden hast und für dein
      Interesse an unserer Bruderschaft. Nachfolgend wollen wir dir einen
      Überblick über unsere Bruderschaft, unsere tolle Gemeinschaft, unsere
      Feste und Veranstaltungen sowie unseren Schießsport geben.
      <span
        class="bigQuote mt-6 block text-[1.5em] font-bold italic text-text-muted"
        >"Für Glaube, Sitte und Heimat"</span
      ><br />
      Nun aber erstmal genug der Geschichte und unserer Grundsätze. Wir wünschen
      dir viel Spaß beim Stöbern auf unserer digitalen Visitenkarte.<br />
      Unser Kontakt:
      <a href="mailto:kontakt@seb-horrem.de" class="underline text-green-800"
        >kontakt@seb-horrem.de</a
      >
    </p>
  </section>

  <section class="section-shell section-light flex flex-col items-center text-center">
    <h2 class="section-title">
      Anstehende Veranstaltungen
    </h2>
    <ul class="text-[1.2rem] text-text-muted">
      <li>
        <span class="font-bold">15.05.2026</span> - <span>Frühlingsfest op Kölsch</span><br>
        <span class="font-bold">16.05.2026 - 17.05.2026</span> - <span>Schützenfest</span>
      </li>
    </ul>
  </section>

  <section class="section-shell section-mint flex flex-col gap-10 md:flex-row">
    <div class="flex-1 flex flex-col items-center justify-center text-center">
      <h2 class="mb-4 text-[32px] font-bold text-text-muted">
        Schützenfest 2025
      </h2>
      <p class="my-4 text-text-muted">
        Vom 30.05 bis 01.06 haben wir unser Frühlingsfest und Schützenfest<br />
        mit euch gefeiert.<br />
        Bilder dazu findet ihr in unserer Galerie.
      </p>
      <div class="flew-row flex flex-wrap items-center justify-center gap-3">
        <a class="btn btn-soft btn-success" href={`${import.meta.env.BASE_URL}schuetzenfest2025/`}>Zu den Bildern</a>
        <a class="btn btn-soft btn-success" href={`${import.meta.env.BASE_URL}majestaeten/`}>Neue Majestäten</a>
      </div>
    </div>
    <div class="flex-1 flex justify-center">
      <img
        src={`${import.meta.env.BASE_URL}assets/img/schuetzenfest_2025/schuetzenfest_cover.jpeg`}
        alt="Gruppenfoto Vorstand"
        class="max-w-full rounded-lg"
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>
</Layout>
