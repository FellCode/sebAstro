---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Schützenjugend | St. Sebastianus Schützenbruderschaft Horrem"
  description="Informationen zur Schützenjugend mit Trainingshinweisen und Kontaktmöglichkeiten."
>
  <section class="section-shell section-mint text-center">
    <h1 class="mb-8 text-[36px] font-bold">Schützenjugend</h1>
    <p class="max-w-[900px] mx-auto leading-8">
      Unsere Schützenjugend steht für Gemeinschaft, Verantwortung und Freude am
      Sport. Kinder und Jugendliche werden altersgerecht begleitet und können
      den Schießsport in einem sicheren, betreuten Rahmen kennenlernen.
    </p>
    <p class="max-w-[900px] mx-auto leading-8 mt-6">
      Trainingszeiten und Details stimmen wir je nach Alter und Gruppe ab. Bei
      Interesse meldet euch gerne unter:
      <a class="underline text-green-800" href="mailto:kontakt@seb-horrem.de">
        kontakt@seb-horrem.de
      </a>
    </p>
  </section>
</Layout>
