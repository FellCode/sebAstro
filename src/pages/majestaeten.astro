---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import ScrollIndicator from "../components/ScrollIndicator.astro";
import HeroBanner from "../components/HeroBanner.astro";
import heroImage from "../assets/images/hero.webp";
import majestaetenImage from "../assets/images/majestaeten.webp";
import bezirksprinzImage from "../assets/images/bezirksprinz.jpeg";
---

<Layout
  title="Amtierende Majestäten | St. Sebastianus Schützenbruderschaft Horrem"
  description="Vorstellung der amtierenden Majestäten der St. Sebastianus Schützenbruderschaft Horrem."
>
  <section
    class="relative flex min-h-screen flex-col items-center justify-center text-center text-white"
  >
    <HeroBanner image={heroImage} alt="Hero-Bild der Majestäten" />
    <div class="mt-24">
      <h1 class="page-title text-white">
        Amtierende Majestäten der St. Sebastianus Schützenbruderschaft Horrem<br
        />
        seit 1550 e.V.
      </h1>
    </div>
    <ScrollIndicator />
  </section>
  <section class="section-shell section-mint flex flex-col items-center text-center">
    <Image
      src={majestaetenImage}
      class="max-w-[800px] mb-2 border-2 rounded-sm mx-auto w-full"
      alt="Gruppenfoto der amtierenden Majestäten"
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 1024px) 800px, 100vw"
      loading="lazy"
      decoding="async"
    />
    <p class="text-text-muted">
      Von Links nach Rechts:<br />
      <strong> Bürgerkönigin</strong><em> Barbara</em><br />
      <strong>Schützenkönig</strong>
      <em>Christian Kurm</em><br />
      <strong>Jungschützenkönigin</strong>
      <em> Gina Glaw + Begleitung</em>
    </p>
  </section>


    <section class="section-shell section-light flex flex-col items-center text-center">

  <h3 class="mb-2 text-[28px] font-normal text-text-muted">
        Bezirksschülerprinz
      </h3>
    <Image
      src={bezirksprinzImage}
      class="max-w-[800px] mb-2 border-2 rounded-sm mx-auto w-full"
      alt="Porträt des Bezirksschülerprinzen"
      widths={[640, 960, 1200]}
      sizes="(min-width: 1024px) 800px, 100vw"
      loading="lazy"
      decoding="async"
    />
    <p class="text-text-muted">
      Jannis Callsen
    </p>
  </section>
</Layout>
