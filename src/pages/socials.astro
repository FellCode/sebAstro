---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import ScrollIndicator from "../components/ScrollIndicator.astro";
import qrInstagram from "../assets/images/qr-instagram.png";
import qrFacebook from "../assets/images/qr-facebook.png";
import qrTiktok from "../assets/images/qr-tiktok.png";
---

<Layout
  title="Social Media | St. Sebastianus Schützenbruderschaft Horrem"
  description="Folge der Bruderschaft auf Instagram, Facebook und TikTok. Hier findest du die offiziellen Social-Media-Kanäle."
>
  <section
    class="relative flex min-h-screen flex-col items-center justify-center text-center text-white"
  >
    <div class="absolute inset-0 -z-10 bg-cover bg-[#83cea5]"></div>
    <div class="mt-24">
      <h1
        class="text-[36px] sm:text-[60px] font-bold font-['Open_Sans'] mb-4 text-[#555]"
      >
        Unsere Social Media Kanäle
      </h1>
      <h2 class="text-[28px] font-normal font-['Open_Sans'] mb-5 text-[#555]">
        Auf folgenden Social-Media-Kanälen könnt ihr uns folgen und abonnieren.
      </h2>
    </div>
    <ScrollIndicator />
  </section>
  <section
    class="bg-[#d4ffe7] flex flex-col items-center px-6 sm:px-10 lg:px-20 py-24 text-center text-[#666]"
  >
    <div class="flex flex-col lg:flex-row justify-around m-8 gap-12">
      <div class="card bg-[#83cea5] shadow-sm">
        <figure class="p-8">
          <Image
            src={qrInstagram}
            alt="QR-Code für das Instagram-Profil"
            class="max-w-64 rounded-md"
            widths={[256, 384, 512]}
            sizes="256px"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <hr class="w-48 h-[2px] mx-auto bg-gray-100 border-0 rounded-sm dark:bg-[#555]" />
        <div class="card-body">
          <h3 class="card-title">Instagram</h3>
          <p class="max-w-96 text-left">
            Scanne den QR-Code oder nutze den Button, um unser Instagram-Profil
            zu besuchen.
          </p>
          <div class="card-actions justify-end">
            <a
              class="btn btn-error"
              href="https://instagram.com"
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram
            </a>
          </div>
        </div>
      </div>

      <div class="card bg-[#83cea5] shadow-sm">
        <figure class="p-8">
          <Image
            src={qrFacebook}
            alt="QR-Code für das Facebook-Profil"
            class="max-w-64 rounded-md"
            widths={[256, 384, 512]}
            sizes="256px"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <hr class="w-48 h-[2px] mx-auto bg-gray-100 border-0 rounded-sm dark:bg-[#555]" />
        <div class="card-body">
          <h3 class="card-title">Facebook</h3>
          <p class="max-w-96 text-left">
            Scanne den QR-Code oder nutze den Button, um unser Facebook-Profil
            zu besuchen.
          </p>
          <div class="card-actions justify-end">
            <a
              class="btn btn-info"
              href="https://facebook.com"
              target="_blank"
              rel="noopener noreferrer"
            >
              Facebook
            </a>
          </div>
        </div>
      </div>

      <div class="card bg-[#83cea5] shadow-sm">
        <figure class="p-8">
          <Image
            src={qrTiktok}
            alt="QR-Code für das TikTok-Profil"
            class="max-w-64 rounded-md"
            widths={[256, 384, 512]}
            sizes="256px"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <hr class="w-48 h-[2px] mx-auto bg-gray-100 border-0 rounded-sm dark:bg-[#555]" />
        <div class="card-body">
          <h3 class="card-title">TikTok</h3>
          <p class="max-w-96 text-left">
            Scanne den QR-Code oder nutze den Button, um unser TikTok-Profil
            zu besuchen.
          </p>
          <div class="card-actions justify-end">
            <a
              class="btn btn-neutral"
              href="https://tiktok.com"
              target="_blank"
              rel="noopener noreferrer"
            >
              TikTok
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
