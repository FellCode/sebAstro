---
import Layout from '../layouts/Layout.astro'
import Gallery from '../components/Gallery.astro'
import ScrollIndicator from '../components/ScrollIndicator.astro'
---

<Layout>
  <section
    class="relative flex min-h-screen flex-col items-center justify-center text-center text-white"
  >
    <div
      class="absolute inset-0 -z-10 bg-cover bg-brand"
      style={`background-image: url(${import.meta.env.BASE_URL}assets/img/hero.webp)`}
    >
    </div>
    <div class="mt-23">
      <h3 class="page-subtitle text-white">
        Hier findest du die schönsten Momente mit unserer
      </h3>
      <h1 class="page-title text-white">
        Jugend
      </h1>
    </div>
    <ScrollIndicator />
  </section>
  <section class="section-shell section-mint items-center justify-center py-40 text">
    <div>
      <Gallery folder="assets/img/jugend_galerie" />
    </div>
  </section>
</Layout>
