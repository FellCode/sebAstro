---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Chronik Bezirksmajestäten | St. Sebastianus Schützenbruderschaft Horrem"
  description="Historische Übersicht der Bezirksmajestäten der St. Sebastianus Schützenbruderschaft Horrem."
>
  <section class="section-shell section-mint text-center">
    <h1 class="mb-8 text-[36px] font-bold">Chronik: Bezirksmajestäten</h1>
    <p class="max-w-[900px] mx-auto leading-8">
      Diese Seite sammelt künftig die Chronik der Bezirksmajestäten. Inhalte
      werden fortlaufend geprüft und ergänzt, um die Vereinsgeschichte
      nachvollziehbar zu dokumentieren.
    </p>
  </section>
</Layout>
