---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Impressum | St. Sebastianus Schützenbruderschaft Horrem"
  description="Impressum der St. Sebastianus Schützenbruderschaft Horrem."
>
  <section class="bg-[#83cea5] px-6 py-24 text-[#666] sm:px-10 lg:px-20">
    <article class="mx-auto max-w-5xl space-y-8 leading-relaxed">
      <header class="space-y-3 text-center">
        <h1 class="font-['Open_Sans'] text-[36px] font-bold">Impressum</h1>
        <p>Angaben gemäß § 5 DDG</p>
      </header>

      <section class="space-y-4">
        <h2 class="text-2xl pb-2">Anbieter</h2>
        <p>
          St. Sebastianus Schützenbruderschaft Horrem seit 1550 e.V<br />
          Mittelstraße 58<br />
          50169 Kerpen<br />
          Deutschland
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-xl">Vertreten durch</h2>
        <p>
          Christian Kurm, Brudermeister<br />
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-xl">Kontakt</h2>
        <p>
          Telefon: 02273 68117<br />
          E-Mail: <a href="mailto:[kontakt@seb-horrem.de]">kontakt@seb-horrem.de</a>
        </p>
      </section>

